{
	"name": "@laboon85/pi-arxiv",
	"version": "0.1.2",
	"description": "Pi extension: fetch arXiv papers (PDF + LaTeX e-print) and convert them into clean, KaTeX-safe Markdown.",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-extension",
		"arxiv",
		"latex",
		"pandoc",
		"markdown",
		"research"
	],
	"files": [
		"README.md",
		"CHANGELOG.md",
		"extensions/",
		"skills/"
	],
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^22.20.5",
		"@types/sax": "1.2.7",
		"@vitest/coverage-v8": "^5.0.3",
		"knip": "^6.40.0",
		"typescript": "^5.9.3",
		"vitest": "^5.0.3"
	},
	"scripts": {
		"dev:link": "node scripts/link-host.mjs",
		"hooks:install": "git config core.hooksPath .githooks",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"knip": "knip",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:network": "node scripts/run-network-tests.mjs",
		"verify": "npm run lint && npm run typecheck && npm run knip && npm run test:coverage",
		"verify:full": "npm run verify",
		"verify:network": "npm run verify && npm run test:network"
	},
	"dependencies": {
		"parse5": "^8.0.1",
		"sax": "1.6.0"
	}
}
