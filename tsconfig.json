{
	"compilerOptions": {
		/* Runtime: Node 22+ with on-the-fly type stripping, ESM only. */
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,

		/*
		 * `erasableSyntaxOnly` is the important one here: it rejects enum, namespace,
		 * and constructor parameter properties, which Node's `--experimental-strip-types`
		 * cannot run. Without it those mistakes only surface at test time.
		 */
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,

		/* Strictness: everything on. */
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noPropertyAccessFromIndexSignature": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"allowUnreachableCode": false,
		"allowUnusedLabels": false,
		"forceConsistentCasingInFileNames": true,

		/* Diagnostics. */
		"skipLibCheck": true,
		"pretty": true,
		"noErrorTruncation": true
	},
	"include": ["extensions/**/*.ts", "tests/**/*.ts"],
	"exclude": ["node_modules", "tests/_out"]
}
